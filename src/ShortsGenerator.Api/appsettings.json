{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=shortsgenerator.db"
  },
  "Ollama": {
    "BaseUrl": "http://127.0.0.1:11434",
    "Model": "llama3.2:3b",
    "KeepAlive": "15m"
  },
  "OutputStorage": {
    "RootDirectory": "../../output"
  },
  "Remotion": {
    "NodePath": "node",
    "TimeoutSeconds": 900,
    "Concurrency": null,
    "SkipUnchangedRenders": true
  },
  "KokoroTts": {
    "Voice": "am_puck",
    "Speed": 1.0,
    "TimeoutSeconds": 300
  },
  "AssetManifest": {
    "ManifestPath": "../../assets/manifests/assets.json"
  }
}
