{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=shortsgenerator.db"
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "llama3.2:3b"
  },
  "OutputStorage": {
    "RootDirectory": "../../output"
  },
  "Remotion": {
    "NodePath": "node",
    "TimeoutSeconds": 900
  },
  "KokoroTts": {
    "Voice": "af_heart",
    "Speed": 1.0,
    "TimeoutSeconds": 300
  },
  "AssetManifest": {
    "ManifestPath": "../../assets/manifests/assets.json"
  }
}
